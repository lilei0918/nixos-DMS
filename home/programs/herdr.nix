{pkgs, ...}: {
  # ============================================================================
  # Herdr
  #
  # Agent-native terminal workspace
  #
  # UI:
  #   Sidebar
  #     ├── Spaces
  #     │    ├── workspace
  #     │    └── git branch / status
  #     │
  #     └── Agents
  #          ├── state
  #          ├── agent
  #          └── workspace / tab
  #
  #   Main area
  #     └── real terminal panes
  #
  # 与 Niri / DMS / Gruvbox 保持统一。
  # ============================================================================

  # ============================================================================
  # Package
  # ============================================================================

  home.packages = [
    pkgs.herdr
  ];

  # ============================================================================
  # Configuration
  # ============================================================================

  xdg.configFile."herdr/config.toml".text = ''
    # ==========================================================================
    # General
    # ==========================================================================

    # 配置由 Home Manager 管理，不需要 Herdr 首次引导
    onboarding = false


    # ==========================================================================
    # Theme
    # ==========================================================================
    #
    # 使用 Herdr 内置 Gruvbox，然后只对关键 UI 元素做轻量调整。
    #
    # 目标：
    #   - 深色背景
    #   - 低对比度 pane
    #   - 黄色作为主 accent
    #   - green / blue / red 用于 agent 状态
    #
    # 不让 Herdr 做成一块特别亮的独立 UI。
    # ==========================================================================

    [theme]

    name = "gruvbox"

    auto_switch = true

    light_name = "gruvbox-light"

    dark_name = "gruvbox"


    # --------------------------------------------------------------------------
    # Gruvbox dark
    # --------------------------------------------------------------------------

    [theme.custom.dark]

    # Gruvbox Dark
    sidebar_bg = "#282828"

    panel_bg = "#282828"

    active_row_bg = "#3c3836"

    selection_bg = "#504945"

    accent = "#fabd2f"

    green = "#b8bb26"

    blue = "#83a598"

    red = "#fb4934"

    yellow = "#fabd2f"


    # --------------------------------------------------------------------------
    # Gruvbox light
    #
    # 不过度定制 light theme，避免与系统浅色主题冲突。
    # --------------------------------------------------------------------------

    [theme.custom.light]

    sidebar_bg = "#fbf1c7"

    panel_bg = "#fbf1c7"

    active_row_bg = "#ebdbb2"

    selection_bg = "#d5c4a1"

    accent = "#b57614"

    green = "#79740e"

    blue = "#076678"

    red = "#9d0006"

    yellow = "#b57614"


    # ==========================================================================
    # Terminal
    # ==========================================================================

    [terminal]

    # 新 terminal pane 使用 fish
    default_shell = "fish"

    # 新 pane / tab / workspace 跟随当前工作目录
    new_cwd = "follow"


    # ==========================================================================
    # Keybindings
    # ==========================================================================

    [keys]

    # tmux-compatible prefix
    prefix = "ctrl+b"


    # --------------------------------------------------------------------------
    # lazygit
    #
    # Ctrl+B → Alt+G
    # --------------------------------------------------------------------------

    [[keys.command]]

    key = "prefix+alt+g"

    type = "popup"

    command = "lazygit"

    width = "72%"

    height = "72%"

    description = "lazygit"


    # --------------------------------------------------------------------------
    # Scratch terminal
    #
    # Ctrl+B → T
    # --------------------------------------------------------------------------

    [[keys.command]]

    key = "prefix+t"

    type = "popup"

    command = "exec \"''${SHELL:-fish}\""

    width = "72%"

    height = "72%"

    description = "scratch terminal"


    # ==========================================================================
    # UI
    # ==========================================================================

    [ui]

    # --------------------------------------------------------------------------
    # Sidebar
    # --------------------------------------------------------------------------
    #
    # 官方默认 sidebar = 26 columns。
    #
    # 你的屏幕是 1920x1080，因此 28 比默认 26 稍微舒服一点。
    #
    # 不要太宽，否则代码/agent terminal 区域会被压缩。
    # --------------------------------------------------------------------------

    sidebar_width = 28

    sidebar_min_width = 24

    sidebar_max_width = 34

    # 启动时保持 Sidebar 展开
    sidebar_start_collapsed = false

    sidebar_collapsed_mode = "compact"


    # --------------------------------------------------------------------------
    # Mouse
    # --------------------------------------------------------------------------

    # Herdr 是 mouse-native UI。
    # 保留鼠标操作：
    #   - 点击 workspace
    #   - 点击 agent
    #   - 拖动 pane
    #   - 右键菜单
    mouse_capture = true

    copy_on_select = true


    # --------------------------------------------------------------------------
    # Agent ordering
    # --------------------------------------------------------------------------

    # 按 workspace / project 分组。
    #
    # 这比单纯按照 agent priority 更符合 Herdr 官网的工作流：
    #
    #   project A
    #      ├── claude
    #      └── opencode
    #
    #   project B
    #      └── codex
    agent_panel_sort = "spaces"


    # --------------------------------------------------------------------------
    # Agent status
    # --------------------------------------------------------------------------

    # 使用不同符号区分：
    #
    #   working
    #   blocked
    #   done
    #   idle
    #
    # 而不是全部使用相同的圆点。
    status_indicators = "symbols"


    # --------------------------------------------------------------------------
    # Tab bar
    # --------------------------------------------------------------------------
    #
    # Sidebar 已经承担主要导航功能。
    # Tab bar 只保留非常少的信息。
    # --------------------------------------------------------------------------

    tab_bar_position = "top"

    tab_bar_right = [
      { type = "datetime", format = "%H:%M" },
    ]

    tab_bar_right_separator = " · "


    # --------------------------------------------------------------------------
    # Window title
    # --------------------------------------------------------------------------

    # 不重复 hostname。
    #
    # Niri / DMS 已经负责桌面级信息。
    window_title = "{workspace}"


    # --------------------------------------------------------------------------
    # Pane borders
    # --------------------------------------------------------------------------
    #
    # 官网思路是：
    #   - 多 pane 时显示边界
    #   - 单 pane 不要画一个巨大的框
    #
    # 这样终端会更干净。
    # --------------------------------------------------------------------------

    pane_borders = "auto"

    pane_outer_borders = false


    # ==========================================================================
    # Sidebar - Spaces
    # ==========================================================================
    #
    # 官方默认：
    #
    #   ● workspace
    #     branch  git_status
    #
    # 这里保持官方信息结构。
    #
    # 对 coding workflow 来说非常合适：
    #
    #   ● nixos-DMS
    #     main  ✓
    #
    #   ● finance
    #     develop  +2 ~1
    #
    # 不把 hostname / machine / 时间塞进去。
    # ==========================================================================

    [ui.sidebar.spaces]

    row_gap = 0

    rows = [
      ["state_icon", "workspace"],
      ["branch", "git_status"],
    ]


    # ==========================================================================
    # Sidebar - Agents
    # ==========================================================================
    #
    # 官方默认布局：
    #
    #   state_icon machine workspace tab
    #   agent
    #
    # 你的情况主要是本机使用，所以去掉 machine。
    #
    # 结果更接近：
    #
    #   ●  nixos-DMS  main
    #      opencode
    #
    #   ◉  finance
    #      claude
    #
    #   ✓  research
    #      codex
    #
    # 让 Agent 名称成为视觉主体。
    # ==========================================================================

    [ui.sidebar.agents]

    row_gap = 1

    rows = [
      ["state_icon", "workspace", "tab"],
      ["agent"],
    ]


    # ==========================================================================
    # Notifications
    # ==========================================================================
    #
    # Agent blocked / done 等状态仍然可以通过 system notification
    # 交给 DMS。
    #
    # 不让 Herdr 自己做大量视觉 toast。
    # ==========================================================================

    [ui.toast]

    delivery = "system"

    delay_seconds = 1


    # ==========================================================================
    # Sound
    # ==========================================================================
    #
    # 关闭 Herdr 音效。
    #
    # DMS/system notification 已经足够。
    # ==========================================================================

    [ui.sound]

    enabled = false


    # ==========================================================================
    # Session
    # ==========================================================================

    [session]

    # Herdr 重启 / detach / reattach 后恢复 agent
    resume_agents_on_restore = true


    # ==========================================================================
    # Worktrees
    # ==========================================================================

    [worktrees]

    directory = "~/.herdr/worktrees"


    # ==========================================================================
    # Advanced
    # ==========================================================================

    [advanced]

    # 每个 pane 50 MB scrollback
    scrollback_limit_bytes = 50000000
  '';
}
