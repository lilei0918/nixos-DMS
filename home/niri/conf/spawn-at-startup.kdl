// 自动启动
// XWayland：niri 25.08 起内置集成（自动 spawn xwayland-satellite），无需手动

// 🔐 权限管理（polkit 认证代理；走 PATH 解析，包在 hosts/legion/packages.nix）
spawn-at-startup "polkit-gnome-authentication-agent-1"

// ⌨️ 输入法（fcitx5 守护进程，-d 后台运行）
spawn-at-startup "fcitx5" "-d"

// 🚀 walker 常驻服务（GTK4 冷启动 ~2-3s；--gapplication-service 常驻后 super+d 唤出仅 ~0.1s）
spawn-at-startup "walker" "--gapplication-service"

// 🔵 蓝牙托盘程序
spawn-at-startup "blueman-applet"

// 📌 延迟启动的应用（QQ 等）
spawn-at-startup "bash" "-c" "sleep 10 && exec qq"
