// 窗口规则
// app-id 用正则子串匹配（如 "libreoffice" 同时命中 writer/calc/impress）

// 1. 通用圆角
window-rule {
    match
    geometry-corner-radius 10 10 5 5
    clip-to-geometry true
}

// 2. 终端固定宽度
window-rule {
    match app-id="Alacritty"
    match app-id="com.mitchellh.ghostty"
    default-column-width { fixed 800; }
}

// 3. 浏览器类（全屏启动）
window-rule {
    match app-id="google-chrome"
    match app-id="firefox"
    open-maximized true
}

// 4. 开发工具占满列宽
window-rule {
    match app-id="dev.zed.Zed"
    match app-id="codium"
    default-column-width { proportion 1.0; }
}

// 5. 办公 / 编辑器占满列宽
window-rule {
    match app-id="libreoffice"
    match app-id="zettlr"
    match app-id="org.gnome.TextEditor"
    default-column-width { proportion 1.0; }
}

// 6. 浮动窗口类（工具 / 对话框型应用）
window-rule {
    match app-id="org.gnome.FileRoller"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="com.rafaelmardojai.Blanket"
    match app-id="localsend_app"
    match app-id="ca.desrt.dconf-editor"
    match app-id="waypaper"
    match app-id="nwg-look"
    match app-id="qt6ct"
    match app-id="org.gnome.Loupe"
    match app-id="zathura"
    match app-id="com.github.johnfactotum.Foliate"
    match app-id="hermes"
    match app-id="org.telegram.desktop"
    open-floating true
}

// 6.1 QQ 浮动 + 固定宽度 800
window-rule {
    match app-id="QQ"
    default-column-width { fixed 800; }
    open-floating true
}

// 6.2 GNOME 小游戏（数独 / 扫雷）浮动 + 终端尺寸
window-rule {
    match app-id="org.gnome.Sudoku"
    match app-id="org.gnome.Mines"
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
    open-floating true
}

// 7. 弹窗类窗口居中浮动
window-rule {
    match title="Open File"
    match title="Save File"
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
    open-floating true
}

// 8. 画中画窗口（Firefox）
window-rule {
    match app-id="firefox" title="Picture-in-Picture"
    match title="Picture in picture"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    open-floating true
    default-floating-position relative-to="bottom-right" x=32 y=32
}

// 9. 特定应用分配到指定工作区
window-rule {
    match app-id="codium"
    open-on-workspace "code"
}
window-rule {
    match app-id="dev.zed.Zed"
    open-on-workspace "code"
}
// 终端类：不分配工作区，保持浮动
window-rule {
    match app-id="Alacritty"
    match app-id="com.mitchellh.ghostty"
    open-floating true
}
// mpv 媒体播放器：无专用工作区，保持浮动
window-rule {
    match app-id="mpv"
    open-floating true
}

// 9.5 浏览器分配到 browser 工作区
window-rule {
    match app-id="google-chrome"
    match app-id="firefox"
    open-on-workspace "browser"
}

// 10. 思源笔记独占一列，分配到 note 工作区
window-rule {
    match app-id="org.b3log.siyuan"
    default-column-width { proportion 1.0; }
    open-on-workspace "note"
}

// 11. Thunar 浮动 + 固定尺寸（app-id 可能是大小写，用 [Tt] 兼容）
window-rule {
    match app-id="[Tt]hunar"
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
    open-floating true
}

// 11.1 Thunar 重命名对话框（小尺寸浮动，覆盖上面的 1200x800）
window-rule {
    match app-id="[Tt]hunar" title="Rename \"|重命名\""
    default-column-width { fixed 420; }
    default-window-height { fixed 180; }
    open-floating true
}
