// 快捷键（binds）
// ⚠️ super+c / super+v 故意不绑：统一留给终端内复制/粘贴（见 home/terminal/）。
binds {
    // 🪟 窗口管理
    super+q { close-window; }
    super+f { fullscreen-window; }
    super+shift+f { maximize-column; }
    // super+t 让给 Piri scratchpad（下拉终端）；浮动切换移到 shift
    super+shift+t { toggle-window-floating; }
    super+h { center-column; }

    // 🔄 工作区切换
    super+tab { focus-workspace-previous; }

    // 📐 列宽调整
    super+1 { set-column-width "25%"; }
    super+2 { set-column-width "50%"; }
    super+3 { set-column-width "75%"; }
    super+4 { set-column-width "100%"; }

    // 🖥️ 启动程序
    super+shift+return { spawn "ghostty"; }
    super+return { spawn "alacritty"; }
    super+d { spawn "walker"; } // walker 已在 spawn-at-startup 常驻，此处只是唤出
    super+e { spawn "thunar"; }
    // Piri scratchpad：下拉 Alacritty 终端（super+t）
    super+t { spawn "piri" "scratchpads" "term" "toggle"; }
    // Piri singleton：chrome 已存在则聚焦，否则启动
    super+b { spawn "piri" "singleton" "chrome" "toggle"; }

    // 📸 截图（niri 内置，Enter/Space 保存，Ctrl+Enter 复制到剪贴板）
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }
    Mod+P { screenshot; }
}
