// 快捷键（binds）
// ⚠️ super+c / super+v 故意不绑：统一留给终端内复制/粘贴（见 home/terminal/）。
binds {
    // 🪟 窗口管理
    super+q { close-window; }
    super+f { fullscreen-window; }
    super+shift+f { maximize-column; }
    super+t { toggle-window-floating; }
    super+h { center-column; }

    // 🔄 工作区切换
    super+tab { focus-workspace-previous; }

    // 📐 列宽调整
    super+1 { set-column-width "25%"; }
    super+2 { set-column-width "50%"; }
    super+3 { set-column-width "75%"; }
    super+4 { set-column-width "100%"; }

    // 🖥️ 启动程序
    super+shift+return { spawn "ghostty"; }
    super+return { spawn "alacritty"; }
    super+d { spawn "walker"; } // walker 已在 spawn-at-startup 常驻，此处只是唤出
    super+e { spawn "thunar"; }
    super+b { spawn "google-chrome-stable"; }

    // 🧩 Noctalia（启动器 / 控制中心 / 设置 / 窗口切换；walker 仍保留在 super+d）
    super+space { spawn-sh "noctalia msg panel-toggle launcher"; }
    super+s { spawn-sh "noctalia msg panel-toggle control-center"; }
    super+shift+comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }

    // 🔊 音量 / 亮度（Noctalia IPC）
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    // 📸 截图（niri 内置，Enter/Space 保存，Ctrl+Enter 复制到剪贴板）
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }
    Mod+P { screenshot; }
}
